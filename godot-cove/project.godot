config_version=5

[application]
config/name="Rich's Houseboat — Deep River"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Rich's Houseboat — Ottawa River"
config/custom_user_dir_name.linux="godot/app_userdata/Rich's Houseboat — Ottawa River"
config/custom_user_dir_name.bsd="godot/app_userdata/Rich's Houseboat — Ottawa River"
run/main_scene="res://title_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[audio]
general/text_to_speech=false

[autoload]
GameFont="*res://game_font.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

fish_interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325,"location":1)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194326,"location":1)]
}

[shader_globals]

river_weather_wet={"type":"float","value":0.0}
river_weather_rain={"type":"float","value":0.0}
river_weather_wind={"type":"float","value":0.0}
river_weather_reflection={"type":"float","value":0.75}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
